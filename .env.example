# Copia este archivo como .env y rellena los valores

# Supabase: Settings > API del teu projecte
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Spotify: developer.spotify.com/dashboard → la teva app → Client ID
# Recorda afegir els Redirect URIs: http://localhost:5173/callback (i la IP de LAN)
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id

# Límit de jugadors per partida (buit = sense límit)
VITE_MAX_PLAYERS=8
